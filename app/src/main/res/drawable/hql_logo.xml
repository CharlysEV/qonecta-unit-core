<?xml version="1.0" encoding="utf-8"?>
<!-- Logo de Qonecta Unit (familia Qonecta+): anillo Q cian→esmeralda con cola de rayo eléctrico
     y arco interior de enlace inalámbrico Unit. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Halo circular interior suave -->
    <path
        android:pathData="M21.5,21.5m-16,0a16,16 0,1 1,32 0a16,16 0,1 1,-32 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="21.5"
                android:centerY="21.5"
                android:gradientRadius="16">
                <item android:color="#2E00E5C7" android:offset="0" />
                <item android:color="#0000E5C7" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Anillo exterior principal de la Q (cian → verde esmeralda Qonecta+) -->
    <path
        android:pathData="M23.08,34.21 A14.4,14.4 0 1 1 34.17,23.12"
        android:strokeWidth="5.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="5.68"
                android:startY="5.72"
                android:endX="34.48"
                android:endY="34.52">
                <item android:color="#FF00E5C7" android:offset="0" />
                <item android:color="#FF4CFF9F" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Arco concéntrico interior (distintivo de Qonecta Unit / radar de enlace) -->
    <path
        android:pathData="M15.8,24.2 A7.2,7.2 0 0 1 24.2,15.8"
        android:strokeWidth="2.6"
        android:strokeColor="#CC80FFEA"
        android:strokeLineCap="round" />

    <!-- Punto central luminoso de proyección -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M21.5,21.5m-2.3,0a2.3,2.3 0,1 1,4.6 0a2.3,2.3 0,1 1,-4.6 0" />

    <!-- Rayo eléctrico de la cola de la Q -->
    <path
        android:pathData="M40.35,22.78 L27.65,35.19 L33.53,36.44 L29.77,46.26 L42.7,32.79 L36.81,31.54 Z"
        android:strokeWidth="0.69"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="27.65"
                android:startY="22.78"
                android:endX="42.7"
                android:endY="46.27">
                <item android:color="#FFFFFFFF" android:offset="0" />
                <item android:color="#FFB8FFDF" android:offset="1" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="27.65"
                android:startY="22.78"
                android:endX="42.7"
                android:endY="46.27">
                <item android:color="#FFFFFFFF" android:offset="0" />
                <item android:color="#FFB8FFDF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
